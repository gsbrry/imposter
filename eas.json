{
  "cli": {
    "version": ">= 18.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_WORDS_FEED_URL": "https://apps.obio.in/imposter/words/feed.json"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_RC_ANDROID_KEY": "goog_mvVZyLBlgQfzdyiUDrqugoNDKbb",
        // No iOS build yet. RevenueCat ignores an empty key, so the app
        // runs without purchases rather than force-closing, which is what a
        // wrong or placeholder key would cause. Set the real appl_ key here
        // when iOS ships.
        "EXPO_PUBLIC_RC_IOS_KEY": "",
        "EXPO_PUBLIC_SENTRY_DSN": "$EXPO_PUBLIC_SENTRY_DSN",
        "EXPO_PUBLIC_WORDS_FEED_URL": "https://apps.obio.in/imposter/words/feed.json",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
